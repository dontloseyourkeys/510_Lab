    {
        "id": "130d1dd882660dfc",
        "type": "function",
        "z": "2fe84bdfcf772d96",
        "name": "Extract temperature",
        "func": "var input = msg.payload; // Assuming the input is in msg.payload \n// Remove any leading or trailing whitespace \ninput = input.trim(); \n// Split the input string using commas as the delimiter \nvar values = input.split(','); \n// Remove leading and trailing whitespace from each value and convert to float \nvalues = values.map(function (value) { \n    return parseFloat(value.trim()); \n}); msg.payload = values[0]; \n// Set the output payload to the array of float values \nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
